{
  /* Build tooling is plain JS but is load-bearing — assert-no-skipped-tests.mjs
     is the sole enforcement of Section 0.2.2. Typecheck it with checkJs rather
     than leaving it unverified. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  /* `fixtures/` is included for the same reason `scripts/` is: H-059 was a
     silently-ignored constructor option that ONLY `checkJs` caught. Fixture
     definitions are the last place an undetected typo should be able to hide,
     since a fixture that quietly tests nothing looks exactly like one that
     passes. */
  "include": ["scripts/**/*.mjs", "scripts/**/*.js", "fixtures/**/*.mjs"]
}
