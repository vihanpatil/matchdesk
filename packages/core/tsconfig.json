{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    /* Section 3.1: core is pure. No DOM, no Node globals — the type system
       enforces the boundary, not just convention. */
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/testkit/**", "src/metamorphic/**"],
  "references": [{ "path": "../shared" }]
}
